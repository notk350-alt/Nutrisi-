# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# DATABASE_PROVIDER: Leave empty for local JSON development; production must explicitly use postgres.
DATABASE_PROVIDER=""
# DATABASE_RUNTIME_ROLE: Exact PostgreSQL login role expected by the runtime role guard.
DATABASE_RUNTIME_ROLE=""
# DATABASE_MIGRATION_ROLE: Exact login principal expected by migration preflight.
DATABASE_MIGRATION_ROLE=""
# DATABASE_URL: Runtime-only PostgreSQL connection. Use a restricted runtime principal.
DATABASE_URL=""
# MIGRATION_DATABASE_URL: Migration-only credential, never expose to web server processes.
MIGRATION_DATABASE_URL=""

# Google OIDC remains disabled until provider credentials and redirect URI are provisioned.
OIDC_ENABLED="false"
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI=""

# Demo login and role switching are disabled by default. Never enable them in production.
ENABLE_DEMO_AUTH="false"
